 using namespace rathena;
 
+static bool map_name_utf8_to_cp949(const char* src, char* dst, size_t dst_size)
+{
+    if (src == nullptr || dst == nullptr || dst_size == 0)
+        return false;
+
+    iconv_t cd = iconv_open("CP949", "UTF-8");
+    if (cd == (iconv_t)-1)
+        return false;
+
+    size_t in_left = strlen(src);
+    size_t out_left = dst_size - 1;
+
+    char* in_buf = const_cast<char*>(src);
+    char* out_buf = dst;
+
+    errno = 0;
+    size_t result = iconv(cd, &in_buf, &in_left, &out_buf, &out_left);
+    int saved_errno = errno;
+
+    *out_buf = '\0';
+    iconv_close(cd);
+
+    if (result != (size_t)-1)
+        return true;
+
+    // Fixed-size client fields are commonly 24 bytes including NUL.
+    // E2BIG means iconv filled the buffer up to a complete CP949 character.
+    return saved_errno == E2BIG;
+}
